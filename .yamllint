---
extends: default

rules:
  document-start: disable
  line-length:
    max: 160
    level: warning
  truthy:
    allowed-values: ['true', 'false', 'yes', 'no']
  comments:
    min-spaces-from-content: 1  # Allow 1 space before comments (prettier default)

ignore: |
  .github/
  .git/
  .venv/
  .jj/
